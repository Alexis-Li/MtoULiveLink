{
  "FileVersion": 3,
  "Version": 10,
  "VersionName": "1.0.0",
  "FriendlyName": "MtoU_LiveLink",
  "Description": "Streams evaluated Maya character animation into Unreal Live Link.",
  "Category": "Animation",
  "CreatedBy": "Alexis-Li",
  "CreatedByURL": "https://github.com/Alexis-Li/MtoULiveLink",
  "DocsURL": "https://github.com/Alexis-Li/MtoULiveLink/blob/main/README.md",
  "CanContainContent": false,
  "Modules": [
    {
      "Name": "MtoULiveLink",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "PlatformAllowList": ["Win64"],
      "TargetAllowList": ["Editor"]
    },
    {
      "Name": "MtoULiveLinkEditor",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "PlatformAllowList": ["Win64"],
      "TargetAllowList": ["Editor"]
    }
  ],
  "Plugins": [
    {
      "Name": "LiveLink",
      "Enabled": true
    },
    {
      "Name": "GeometryScripting",
      "Enabled": true
    },
    {
      "Name": "LevelSequenceEditor",
      "Enabled": true
    }
  ]
}
